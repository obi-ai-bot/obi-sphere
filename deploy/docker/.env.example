# Your Obysphere's address: a domain or subdomain whose DNS A (or AAAA) record points at this server.
SPHERE_DOMAIN=sphere.example.com

# Leave it empty: the Sphere prints a one-time claim link (docker compose logs sphere), and you claim
# it with that link (docs/self-host-docker.md). Or put an operator token you made here, at least 32
# characters, which skips the claim; then `chmod 600 .env`.
SPHERE_OPERATOR_TOKEN=

# Optional: sign-in, so people from these domains can create Obyspheres too (docs/run-your-own.md,
# "Optional: let your team create Obyspheres"). Google with its client id, and any other OpenID
# Connect provider as a JSON list, on one line:
# SIGNIN_PROVIDERS=[{"id":"acme","name":"Acme SSO","issuer":"https://sso.acme.com","client_id":"…","domain":"acme.com"}]
GOOGLE_CLIENT_ID=
SIGNIN_PROVIDERS=
CREATOR_WORKSPACES=

# Optional: `off` turns off the phone relay, the extension that lets a member's phone reach its agent
# through the Sphere (spec/sphere-api.md section 9). On when empty.
PHONE_RELAY=

# Optional: a version to stay on instead of the latest.
SPHERE_VERSION=latest
