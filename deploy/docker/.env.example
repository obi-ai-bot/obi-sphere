# Your Obysphere's address: a domain or subdomain whose DNS A (or AAAA) record points at this server.
SPHERE_DOMAIN=sphere.example.com

# Leave it empty: the Sphere prints a one-time claim link (docker compose logs sphere), and Oby
# claims it. Or put the token Oby copied (Settings › Obysphere › Host your own) here, which skips the claim.
SPHERE_OPERATOR_TOKEN=

# Optional: Google sign-in, so people in these Google Workspaces can create Obyspheres too
# (docs/run-your-own.md, "Optional: let your team create Obyspheres").
GOOGLE_CLIENT_ID=
CREATOR_WORKSPACES=

# Optional: a version to stay on instead of the latest.
SPHERE_VERSION=latest
