{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // Node runs the conformance checker's .ts files as they are (type stripping): imports name
    // their .ts files, and only syntax Node can erase is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  // worker.vitest.ts, conformance/, scripts/ and e2e/ are Node code: vitest and Node run them as they are.
  "include": ["src", "test"]
}
