{
  "name": "@obysphere/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A client library for the Obi-to-Obi protocol v0.1: keys, owner-signed cards, delegation and tokens; building, signing, sealing, opening and verifying envelopes; the audit chain; and an Obysphere's HTTP API.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.23.0",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts"
  },
  "publishConfig": {
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./protocol": { "types": "./dist/protocol.d.ts", "default": "./dist/protocol.js" }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "check": "node scripts/gen.mjs && tsc --noEmit",
    "test": "node scripts/gen.mjs && node --test test/*.test.ts",
    "conformance": "node scripts/gen.mjs && node scripts/conformance.mjs",
    "e2e": "node scripts/gen.mjs && node e2e/run.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "ajv": "8.20.0",
    "typescript": "^5.9.0"
  }
}
